# Copy to .env.local and fill in. .env* is gitignored — nothing here is a
# real secret, this file just documents what exists.

# --- Market data (TERMINAL_SPEC.md §3) ---
# Gold (XAU/USD) + forex majors poll this key every 30-60s and synthesize
# ticks between polls. Free signup, no card, 800 req/day: https://twelvedata.com
# Absent -> /api/quotes/[symbol] falls back to a clearly-labeled deterministic
# mock series, so the app runs fine without this for local dev.
TWELVE_DATA_API_KEY=

# --- Backend (TERMINAL_SPEC.md §2, Phase B of the roadmap) ---
# Supabase project URL + keys, once a project exists (Phase B step 2 — needs
# a human to create the project; see /Users/aiseosauyi-idahor/.claude/plans/radiant-purring-cake.md).
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the client, never prefixed NEXT_PUBLIC_.
# Bypasses Row Level Security: only used by the cron evaluator route and the
# migration route, both of which enforce their own user scoping in code.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flag: dataStore.ts picks the localStorage impl when this is unset,
# the Postgres-backed impl when it's "1". Flip, not a code removal, if
# something's wrong with the backend path.
NEXT_PUBLIC_BACKEND_ENABLED=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it hits /api/cron/evaluate-triggers or /api/cron/daily-digest, so those
# routes can reject any caller that isn't the actual scheduled job. Generate
# with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Email digests (TERMINAL_SPEC.md §6, Phase F) ---
# Brevo transactional email (https://brevo.com) — chosen over Resend since
# Brevo's single-sender verification doesn't need a verified domain. Create
# an API key under Settings -> SMTP & API, and verify BREVO_SENDER_EMAIL as
# a single sender in the Brevo dashboard first. Absent either -> the digest
# cron logs and skips sending instead of throwing (src/lib/brevo.ts).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Used to build the unsubscribe link in digest emails (e.g.
# https://zoqo.example.com). Absent -> the link is relative-only, which
# still works from most mail clients but is worth setting for production.
NEXT_PUBLIC_SITE_URL=
